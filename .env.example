# =============================================================================
# AML Transaction Monitoring — Environment Configuration
# =============================================================================
# Copy this file to `.env` and fill in the values for your environment.
# `.env` is gitignored and never committed. The service reads these variables
# through src/utils/config.py at startup.

# ---- LLM provider (required) -----------------------------------------------
# Anthropic Claude powers the case narrative generation layer.
# Provision a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ---- LLM observability (optional but recommended) --------------------------
# Langfuse traces every LLM call with cost, latency, and token telemetry.
# Self-host or use the managed plan at https://cloud.langfuse.com/
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- Persistence -----------------------------------------------------------
# SQLite is the default and ships with the repo. Postgres is supported by
# changing the URL to postgresql+psycopg2://user:pass@host:5432/aml.
DATABASE_URL=sqlite:///./aml_alerts.db

# ---- Outbound webhook (optional) -------------------------------------------
# Slack-compatible incoming webhook URL. Alerts dispatch fire-and-forget
# with bounded retry. Leave WEBHOOK_ENABLED=false to skip delivery entirely.
WEBHOOK_URL=
WEBHOOK_ENABLED=false

# ---- Model artifact --------------------------------------------------------
MODEL_PATH=models/ensemble.pkl

# ---- API runtime -----------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=local
